PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
# Gmail SMTP example. Use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-taskflow-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=TaskFlow Security <your-taskflow-sender@gmail.com>
